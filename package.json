 {
  "name": "gym-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "paraglide:compile": "bunx paraglide-js compile --project ./project.inlang --outdir ./paraglide",
    "dev": "bun run paraglide:compile && bun --bun next dev",
    "build": "bun run paraglide:compile && bun --bun next build",
    "start": "bun --bun next start",
    "lint": "bun --bun eslint",
    "lint:fix": "bun --bun eslint --fix",
    "prisma:generate": "bun --bun prisma generate",
    "prisma:migrate": "bun --bun prisma migrate dev",
    "prisma:studio": "bun --bun prisma studio"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.18.0",
    "@prisma/adapter-pg": "7.4.1",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-form": "^1.28.3",
    "better-auth": "^1.4.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "dotenv": "^17.3.1",
    "lucide-react": "^1.14.0",
    "next": "16.1.6",
    "pg": "^8.19.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^7.8.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
